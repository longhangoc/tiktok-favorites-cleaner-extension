{
  "manifest_version": 3,
  "name": "TikTok Favorites Cleaner",
  "version": "1.0.0",
  "description": "Tự động xoá toàn bộ video khỏi mục Yêu thích trên TikTok. Có chạy thử, xác nhận, và 2 cơ chế xoá (API nhanh + giao diện).",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["https://www.tiktok.com/*"],
  "action": {
    "default_title": "TikTok Favorites Cleaner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}